{
	"name": "@prc/nexus",
	"version": "1.0.0",
	"description": "PRC Nexus is a collection of AI powered tools, UI components, orchestration, and utilities for the PRC Platform.",
	"main": "./src/index.js",
	"scripts": {
		"build": "wp-scripts build --output-path=./build/plugin; wp-scripts build src/exports.js --output-path=./build/exports",
		"build:plugin": "wp-scripts build --output-path=./build/plugin",
		"start:plugin": "wp-scripts start --output-path=./build/plugin",
		"build:exports": "wp-scripts build src/exports.js --output-path=./build/exports",
		"start:exports": "wp-scripts start src/exports.js --output-path=./build/exports",
		"test": "wp-scripts test-playwright",
		"test:env:start": "wp-env start",
		"test:env:stop": "wp-env stop",
		"test:env:clean": "wp-env clean all && wp-env start",
		"test:env:destroy": "wp-env destroy",
		"composer": "composer"
	},
	"devDependencies": {
		"@wordpress/env": "^10.35.0",
		"@wordpress/scripts": "^31.0.0"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@wordpress/icons": "^11.2.0",
		"turndown": "^7.2.1",
		"@wordpress/dataviews": "^10.3.0",
		"@wordpress/dom-ready": "^3.0.0",
		"@wordpress/element": "^5.0.0"
	}
}
